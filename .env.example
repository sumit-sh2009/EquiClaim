# Copy to backend/.env for local development.
# All variables are consumed by app.core.config.Settings (env_prefix="EQUICLAIM_").

EQUICLAIM_DATABASE_URL=postgresql://equiclaim:equiclaim@localhost:5432/equiclaim
EQUICLAIM_DB_POOL_MIN_SIZE=2
EQUICLAIM_DB_POOL_MAX_SIZE=20

# Evaluator-optimizer loop safety (mandate: max 3 iterations, hard recursion backstop below that)
EQUICLAIM_GRAPH_RECURSION_LIMIT=50
EQUICLAIM_EVALUATOR_MAX_ITERATIONS=3

EQUICLAIM_ENVIRONMENT=development
EQUICLAIM_CORS_ALLOW_ORIGINS=["http://localhost:5173"]
EQUICLAIM_UPLOAD_DIR=./data/uploads

# Phase 8 hardens this into real per-tenant auth; dev-only shared secret for now.
EQUICLAIM_API_SHARED_SECRET=dev-shared-secret-change-me

# Frontend (Vite) — see frontend/.env
VITE_API_BASE_URL=http://localhost:8000
VITE_API_BEARER_TOKEN=dev-shared-secret-change-me
VITE_TENANT_ID=demo-tenant
